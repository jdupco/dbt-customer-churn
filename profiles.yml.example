dbt_customer_churn:
  target: dev

  outputs:
    dev:
      type: databricks
      catalog: dev
      schema: dev
      auth_type: oauth
      host: "{{ env_var('DBT_DATABRICKS_HOST_DEV') }}"
      http_path: "{{ env_var('DBT_DATABRICKS_HTTP_PATH_DEV') }}"

    prod:
      type: databricks
      catalog: prod
      schema: prod
      auth_type: oauth
      host: "{{ env_var('DBT_DATABRICKS_HOST_PROD') }}"
      http_path: "{{ env_var('DBT_DATABRICKS_HTTP_PATH_PROD') }}"
